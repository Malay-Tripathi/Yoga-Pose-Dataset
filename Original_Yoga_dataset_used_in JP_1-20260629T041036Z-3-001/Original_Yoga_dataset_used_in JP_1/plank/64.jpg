<style>
  :root{
    --o1:#ff7a00; --o2:#ff9f3c; --o3:#ffb86a; --o4:#ffefe0;
    --ink:#3a1900; --panel:rgba(255,255,255,.08); --line:rgba(255,255,255,.25);
  }
  .sb-wrap{
    max-width: 760px; margin: 0 auto; padding: 14px;
    font-family: system-ui,-apple-system,Segoe UI,Roboto,'Poppins',sans-serif;
    color: #fff;
    background: linear-gradient(180deg, #ff7a00, #c95100);
    border: 1px solid var(--line); border-radius: 16px;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.05), 0 14px 34px rgba(0,0,0,.28);
  }
  .sb-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}
  .sb-head h3{margin:0;font-weight:900;letter-spacing:.3px;text-shadow:0 0 14px rgba(255,200,150,.5)}
  .sb-stats{display:flex;align-items:center;gap:12px;font-weight:900}
  .sb-btn{
    padding:8px 12px;border:1px solid var(--line);border-radius:10px;cursor:pointer;
    background:linear-gradient(180deg,var(--o3),#fff); color:var(--ink); font-weight:900;
    box-shadow:0 6px 16px rgba(0,0,0,.2); transition:.15s;
  }
  .sb-btn:hover{transform:translateY(-2px)}
  .sb-canvas-wrap{position:relative;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:linear-gradient(180deg,#ff9f3c22,#ff7a0015)}
  canvas{display:block;width:100%;height:420px}
  .sb-tip{
    position:absolute; left:50%; bottom:10px; transform:translateX(-50%);
    padding:6px 10px; border-radius:999px; font-weight:800; font-size:12px;
    color:#5d2b00; background:linear-gradient(180deg,var(--o4),#fff);
    border:1px solid rgba(255,255,255,.6); box-shadow:0 4px 10px rgba(0,0,0,.2)
  }
  @media (max-width:560px){ canvas{height:360px} }
</style>

<script>
(()=>{
  const canvas = document.getElementById('sbCanvas');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('sbScore');
  const timeEl  = document.getElementById('sbTime');
  const btnRestart = document.getElementById('sbRestart');

  // --- responsive canvas with DPR scaling
  function fitCanvas(){
    const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
    const rect = canvas.getBoundingClientRect();
    canvas.width  = Math.floor(rect.width * dpr);
    canvas.height = Math.floor(rect.height * dpr);
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  fitCanvas(); window.addEventListener('resize', fitCanvas);

  // --- game state
  let balls = [], bullets = [], particles = [];
  let score = 0, timeLeft = 60, lastSpawn = 0, running = true, rafId=0;

  // util
  const rand = (a,b)=>Math.random()*(b-a)+a;
  const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));

  function spawnBall(){
    const r = rand(18,28);
    const x = rand(r+6, canvas.clientWidth - (r+6));
    const y = rand(r+6, canvas.clientHeight*0.5);
    const vx = rand(-1.2,1.2) || 0.6, vy = rand(0.6,1.4);
    const n  = Math.floor(rand(1,10));
    balls.push({x,y,r,vx,vy,n});
  }

  function shootTowards(mx,my){
    // cannon at bottom-center
    const sx = canvas.clientWidth/2, sy = canvas.clientHeight-6;
    const ang = Math.atan2(my - sy, mx - sx);
    const spd = 6;
    bullets.push({x:sx, y:sy, vx:Math.cos(ang)*spd, vy:Math.sin(ang)*spd, life:90});
  }

  // input
  canvas.addEventListener('pointerdown', e=>{
    const rect = canvas.getBoundingClientRect();
    shootTowards(e.clientX - rect.left, e.clientY - rect.top);
  }, {passive:true});

  btnRestart.addEventListener('click', reset);

  // particles
  function boom(x,y,color="#fff"){
    for(let i=0;i<14;i++){
      particles.push({
        x,y, vx:rand(-2,2), vy:rand(-2,2), life: rand(20,36),
        c: color
      });
    }
  }

  function update(){
    if(!running){ cancelAnimationFrame(rafId); return; }

    const w = canvas.clientWidth, h = canvas.clientHeight;

    // clear
    ctx.clearRect(0,0,w,h);

    // draw background subtle grid
    ctx.save();
    ctx.globalAlpha = .08;
    ctx.fillStyle = "#ffffff";
    for(let x=0;x<w;x+=28){ ctx.fillRect(x,0,1,h); }
    for(let y=0;y<h;y+=28){ ctx.fillRect(0,y,w,1); }
    ctx.restore();

    // spawn balls gradually
    if(performance.now() - lastSpawn > 900 && balls.length < 10){
      spawnBall(); lastSpawn = performance.now();
    }

    // update balls
    balls.forEach(b=>{
      b.x += b.vx; b.y += b.vy;
      // bounce walls
      if(b.x < b.r){ b.x = b.r; b.vx *= -1; }
      if(b.x > w-b.r){ b.x = w-b.r; b.vx *= -1; }
      if(b.y < b.r){ b.y = b.r; b.vy *= -1; }
      if(b.y > h*0.75){ b.y = h*0.75; b.vy *= -1; }
      // draw ball
      const grad = ctx.createRadialGradient(b.x-b.r*0.4, b.y-b.r*0.4, 2, b.x, b.y, b.r);
      grad.addColorStop(0, "#fff7e6");
      grad.addColorStop(1, "#ff9f3c");
      ctx.fillStyle = grad;
      ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,Math.PI*2); ctx.fill();
      ctx.lineWidth=2; ctx.strokeStyle="rgba(255,255,255,.6)"; ctx.stroke();

      // number
      ctx.fillStyle="#4a2200"; ctx.font="bold 16px system-ui,Segoe UI,Roboto";
      ctx.textAlign="center"; ctx.textBaseline="middle";
      ctx.fillText(b.n, b.x, b.y);
    });

    // update bullets
    ctx.fillStyle="#ffffff";
    bullets.forEach(bt=>{
      bt.x += bt.vx; bt.y += bt.vy; bt.life--;
      ctx.beginPath(); ctx.arc(bt.x,bt.y,4,0,Math.PI*2); ctx.fill();
    });
    bullets = bullets.filter(b=>b.life>0 && b.x>-10 && b.x<w+10 && b.y>-10 && b.y<h+10);

    // collisions
    for(let i=balls.length-1;i>=0;i--){
      const b = balls[i];
      for(let j=bullets.length-1;j>=0;j--){
        const u = bullets[j];
        const dx = b.x-u.x, dy=b.y-u.y;
        if(dx*dx+dy*dy <= (b.r+4)*(b.r+4)){
          score += b.n; scoreEl.textContent = score;
          boom(b.x,b.y,"#fff3cc");
          balls.splice(i,1); bullets.splice(j,1);
          break;
        }
      }
    }

    // particles
    particles.forEach(p=>{
      p.x+=p.vx; p.y+=p.vy; p.life--;
      ctx.globalAlpha = Math.max(0, p.life/36);
      ctx.fillStyle=p.c; ctx.fillRect(p.x,p.y,3,3);
      ctx.globalAlpha=1;
    });
    particles = particles.filter(p=>p.life>0);

    rafId = requestAnimationFrame(update);
  }

  // timer
  let timerId;
  function startTimer(){
    clearInterval(timerId);
    timeLeft = 60;
    timeEl.textContent = timeLeft;
    timerId = setInterval(()=>{
      timeLeft--;
      timeEl.textContent = timeLeft;
      if(timeLeft<=0){
        clearInterval(timerId);
        running=false;
        // small overlay text
        const w = canvas.clientWidth, h = canvas.clientHeight;
        ctx.fillStyle="rgba(0,0,0,.25)"; ctx.fillRect(0,0,w,h);
        ctx.fillStyle="#fff";
        ctx.font="900 22px system-ui,Segoe UI,Roboto";
        ctx.textAlign="center";
        ctx.fillText("Waktu Habis! Skor: "+score, w/2, h/2);
      }
    },1000);
  }

  function reset(){
    balls.length=0; bullets.length=0; particles.length=0;
    score=0; scoreEl.textContent=score;
    running=true; lastSpawn=0;
    startTimer();
    cancelAnimationFrame(rafId);
    update();
  }

  // start
  reset();
})();
</script>
<!-- ===== END MINI GAME ===== -->
<!-- ===== PREDIKSI TOGEL HARIAN (ORANGE THEME) ===== -->
