<script>
(()=>{
// ===== Seeded RNG (xorshift32) agar hasil konsisten per hari + pasaran =====
function xorshift32(seed){
  let x = seed|0; if(x===0) x=123456789;
  return ()=>{ x ^= x<<13; x ^= x>>>17; x ^= x<<5; return (x>>>0) / 4294967296; };
}
function strSeed(s){
  let h=2166136261; for(let i=0;i<s.length;i++){ h ^= s.charCodeAt(i); h = Math.imul(h,16777619); }
  return h>>>0;
}
function pad(n,len){ return String(n).padStart(len,'0'); }

// ===== Generator angka =====
function pickDistinct(rng, count, min, max){
  const set = new Set();
  while(set.size<count){
    const v = Math.floor(rng()*(max-min+1))+min;
    set.add(v);
  }
  return [...set];
}
function genSet(rng, len, qty){
  const out = new Set();
  while(out.size<qty){
    const v = pad(Math.floor(rng()*Math.pow(10,len)), len);
    out.add(v);
  }
  return [...out];
}

// ===== Shio =====
const SHIO = ["Tikus","Kerbau","Macan","Kelinci","Naga","Ular","Kuda","Kambing","Monyet","Ayam","Anjing","Babi"];
function genShio(rng, qty=3){
  const idxs = pickDistinct(rng, qty, 0, SHIO.length-1);
  return idxs.map(i=>SHIO[i]);
}

// ===== UI =====
const selMarket = document.getElementById('pMarket');
const inpDate   = document.getElementById('pDate');
const btnGen    = document.getElementById('btnGen');
const btnShuffle= document.getElementById('btnShuffle');
const el4d = document.getElementById('n4d');
const el3d = document.getElementById('n3d');
const el2d = document.getElementById('n2d');
const elcb = document.getElementById('ncb');
const elsh = document.getElementById('nshio');
const info = document.getElementById('genInfo');
const log  = document.getElementById('log');

// Set default tanggal = hari ini (lokal)
const today = new Date();
inpDate.value = new Date(today.getTime()-today.getTimezoneOffset()*60000).toISOString().slice(0,10);
let extraSalt = 0;

function renderBadges(container, arr){
  container.innerHTML = arr.map(v=>`<span class="badge">${v}</span>`).join('');
}
function copyText(targetId){
  const box = document.getElementById(targetId);
  const txt = [...box.querySelectorAll('.badge')].map(b=>b.textContent).join(' ');
  navigator.clipboard.writeText(txt).catch(()=>{});
}
document.querySelectorAll('.copy').forEach(btn=>{
  btn.addEventListener('click', ()=>copyText(btn.dataset.target));
});

function generate(){
  const dateStr = inpDate.value || new Date().toISOString().slice(0,10);
  const key = `${selMarket.value}|${dateStr}|${extraSalt}`;
  const rng = xorshift32(strSeed(key));

  // Kuantitas & panjang angka bisa disesuaikan
  const arr4d = genSet(rng, 4, 6);   // 6 kombinasi 4D
  const arr3d = genSet(rng, 3, 6);   // 6 kombinasi 3D
  const arr2d = genSet(rng, 2, 8);   // 8 kombinasi 2D
  const cb    = pickDistinct(rng, 5, 0, 9); // 5 colok bebas
  const shio  = genShio(rng, 3);     // 3 shio

  renderBadges(el4d, arr4d);
  renderBadges(el3d, arr3d);
  renderBadges(el2d, arr2d);
  renderBadges(elcb, cb.map(n=>String(n)));
  renderBadges(elsh, shio);

  info.textContent = `Generated untuk ${selMarket.value} • ${dateStr} • seed:${extraSalt}`;
  const item = document.createElement('li');
  item.textContent = `[${new Date().toLocaleTimeString()}] ${selMarket.value} ${dateStr} (salt ${extraSalt})`;
  log.prepend(item);
}

btnGen.addEventListener('click', ()=>{ extraSalt=0; generate(); });
btnShuffle.addEventListener('click', ()=>{ extraSalt++; generate(); });

// Auto-generate saat load
generate();
})();
</script>
<!-- ===== END PREDIKSI TOGEL HARIAN ===== -->

