/* Videos */
.swiper-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: -webkit-box;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    -webkit-transition-property: -webkit-transform;
    transition-property: -webkit-transform;
    -o-transition-property: transform;
    transition-property: transform;
    transition-property: transform,-webkit-transform;
    -webkit-box-sizing: content-box;
    box-sizing: content-box;
}

.swiper-container.swiper-container-initialized.swiper-container-horizontal {
    margin-left: auto;
    margin-right: auto;
    position: relative;
    overflow: hidden;
    list-style: none;
    padding: 0;
    z-index: 1;
}
.vimeography-thumbnail-container {
    position: relative;
}
.vimeography-gallery {
    width: 90%;
    margin: 0 auto 1rem;
}
figure.swiper-slide.vimeography-thumbnail.vimeography-video-397171653.swiper-slide-active {
    flex-shrink: 0;
    height: 100%;
    width: auto;
    position: relative;
}

a.vimeography-link {
    display: block;
    font-size: 0;
    line-height: 0;
    border-radius: 4px;
    box-shadow: none;
}
img.vimeography-thumbnail-img {
    border-radius: 4px;
    max-width: 198px;
    cursor: pointer;
}

.swiper-button-prev {
    cursor: pointer;
    width: 12px;
    height: 20px;
    margin-top: -10px;
    background-size: 12px 20px;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2027%2044'%3E%3Cpath%20d%3D'M0%2C22L22%2C0l2.1%2C2.1L4.2%2C22l19.9%2C19.9L22%2C44L0%2C22L0%2C22L0%2C22z'%20fill%3D'%23007aff'%2F%3E%3C%2Fsvg%3E") !important;
    left: 10px;
    position: absolute;
    right: auto;
    top: 50%;
    background-position: center;
    background-repeat: no-repeat;
	left: -20px;
}
.swiper-button-next {
    cursor: pointer;
    width: 12px;
    height: 20px;
    margin-top: -10px;
    background-size: 12px 20px;
    right: -20px;
    right: 10px;
    left: auto;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%2027%2044'%3E%3Cpath%20d%3D'M27%2C22L27%2C22L5%2C44l-2.1-2.1L22.8%2C22L2.9%2C2.1L5%2C0L27%2C22L27%2C22z'%20fill%3D'%23007aff'%2F%3E%3C%2Fsvg%3E") !important;
    position: absolute;
    top: 50%;
    background-position: center;
    background-repeat: no-repeat;
	right: -20px;
}
.swiper-slide {
    flex-shrink: 0;
    height: 100%;
    width: auto;
    position: relative;
		margin: 0;
}
