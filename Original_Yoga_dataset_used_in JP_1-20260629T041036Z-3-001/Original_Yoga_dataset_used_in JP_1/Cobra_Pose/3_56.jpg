			<div class="vc_single_image-wrapper   vc_box_border_grey"><img decoding="async" width="563" height="718" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20563%20718'%3E%3C/svg%3E" class="vc_single_image-img attachment-full" alt="" title="Bianca-Machlis-YogaSynergy-YTT-01" data-lazy-srcset="https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01.jpg 563w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-235x300.jpg 235w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-100x128.jpg 100w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-400x510.jpg 400w" data-lazy-sizes="(max-width: 563px) 100vw, 563px" data-lazy-src="https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01.jpg" /><noscript><img decoding="async" width="563" height="718" src="https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01.jpg" class="vc_single_image-img attachment-full" alt="" title="Bianca-Machlis-YogaSynergy-YTT-01" srcset="https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01.jpg 563w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-235x300.jpg 235w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-100x128.jpg 100w, https://yogasynergy.s3.ap-southeast-2.amazonaws.com/~yogasyne/wp-content/uploads/2023/12/19192720/Bianca-Machlis-YogaSynergy-YTT-01-400x510.jpg 400w" sizes="(max-width: 563px) 100vw, 563px" /></noscript></div>
