/* FAQs block */
.faqs-block > h3 {
	max-width: 710px !important;
}


/* Borlabs */
#BorlabsCookieBox ul.brlbs-cmpnt-consent-list li::before {
    display: none !important;
}

#BorlabsCookieBox .brlbs-cmpnt-container :is(.brlbs-mx-2) {
	margin: 0;
}

#BorlabsCookieBox .brlbs-cmpnt-container .brlbs-cmpnt-dialog div[role="document"] {
    max-width: 1440px;
    margin: auto;
}

#BorlabsCookieBox button.brlbs-cmpnt-btn:not(.brlbs-cmpnt-link) {
	border: 2px solid #000;
}

#BorlabsCookieBox button.brlbs-cmpnt-btn:not(.brlbs-btn-accept-all) {
	border-color: transparent;
}

#BorlabsCookieBox button.brlbs-cmpnt-btn:not(.brlbs-cmpnt-link):hover {
  background-color: transparent !important;
  border-color: #000;
}

@media (max-width: 600px) {
	#BorlabsCookieBox .brlbs-cmpnt-tab-bar {
			flex-wrap: wrap;
			gap: 7px;
	}

	#BorlabsCookieBox .brlbs-cmpnt-tab-bar .brlbs-cmpnt-tab {
			flex: 0 0 calc(50% - 10px);
			border: 1px solid #000;
	}
}

@media (max-width: 400px) {
	#BorlabsCookieBox .brlbs-cmpnt-tab-bar .brlbs-cmpnt-tab {
		font-size: 12px;
	}
}

@media (min-width: 1500px) {
    .project-overview .project-overview__item:first-child .project-overview__item-thumbnail {
        height: 620px;
    }
}


.customer-logo-columns-section .cls-1,
.customer-logo-columns-section .cls-2 {
    fill: #000;
}
