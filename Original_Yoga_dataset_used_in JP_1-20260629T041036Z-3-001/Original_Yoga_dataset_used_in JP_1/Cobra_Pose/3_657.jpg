/* password required */
.container.page.post-password-required {
	padding-left: 37px;
	padding-right: 37px;
}

.post-password-form [type="submit"] {
	margin-top: 15px;
}

@media (min-width: 768px) {
	.container.page.post-password-required {
		width: 73.68421%;
    margin-left: auto;
    margin-right: auto;
    max-width: 1240px;
		padding-left: 23px;
		padding-right: 23px;
	}
}
/* end password required */

@media (min-width: 1024px) {
	.container--home-kompetenzen {
		margin-top: 0 !important;
	}
	
	.home-intro__help {
		margin-bottom: 0;
	}
	
	/* js-featured-project */
	.seo-project__info p {
		font-size: 1.95vh !important;
    line-height: 1.5 !important;
	}
}

@media (min-width: 1366px) {
		/* js-featured-project */
	.seo-project__info p {
		font-size: 2.3vh !important;
	}
}

@media (min-width: 1441px) {
			/* js-featured-project */
	.seo-project__info p {
		font-size: 21px !important;
	}
}

